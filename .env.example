# Copy this file to .env and fill in local values. Never commit .env.
APP_ENV=development
SECRET_KEY=

DB_HOST=localhost
DB_USER=mh_chatbot_app
DB_PASSWORD=PASTE_YOUR_ACTUAL_PASSWORD_HERE
DB_NAME=mh_chatbot
DB_PORT=3306

CONFIDENCE_THRESHOLD=0.40
MAX_FOLLOW_UP_QUESTIONS=2
VIDEO_MATCH_THRESHOLD=0.55
VIDEO_GENERATION_DIR=static/generated_videos
VIDEO_MAX_SECONDS=90
# Optional: use a Devanagari-capable .ttf font if no supported system font is found.
HINDI_FONT_PATH=
LOG_LEVEL=INFO
